{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.txt",
      "use": "@vercel/static"
    },
    {
      "src": "*.xml",
      "use": "@vercel/static"
    },
    {
      "src": "*.svg",
      "use": "@vercel/static"
    },
    {
      "src": "*/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "en/**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/en/privacy",
      "dest": "/en/privacy/index.html"
    },
    {
      "src": "/privacy",
      "dest": "/privacy/index.html"
    },
    {
      "src": "/kurz/success",
      "dest": "/kurz/success.html"
    },
    {
      "src": "/en/kurz/success",
      "dest": "/en/kurz/success.html"
    },
    {
      "src": "/kurz/player",
      "dest": "/course-player.html"
    },
    {
      "src": "/en/kurz/player",
      "dest": "/course-player.html"
    },
    {
      "src": "^/sk(/.*)?$",
      "dest": "$1",
      "status": 302
    },
    {
      "src": "/(.*)\\.txt",
      "dest": "/$1.txt"
    },
    {
      "src": "/(.*)\\.xml",
      "dest": "/$1.xml"
    },
    {
      "src": "/(.*)\\.svg",
      "dest": "/$1.svg"
    },
    {
      "src": "/(.*)\\.css",
      "dest": "/$1.css"
    },
    {
      "src": "/en",
      "dest": "/en/index.html"
    },
    {
      "src": "/en/",
      "dest": "/en/index.html"
    },
    {
      "src": "/en/kurz",
      "dest": "/en/kurz/index.html"
    },
    {
      "src": "/en/o-nas",
      "dest": "/en/o-nas/index.html"
    },
    {
      "src": "/en/faq",
      "dest": "/en/faq/index.html"
    },
    {
      "src": "/en/blog",
      "dest": "/en/blog/index.html"
    },
    {
      "src": "/en/affiliate",
      "dest": "/en/affiliate/index.html"
    },
    {
      "src": "/kurz",
      "dest": "/kurz/index.html"
    },
    {
      "src": "/o-nas",
      "dest": "/o-nas/index.html"
    },
    {
      "src": "/faq",
      "dest": "/faq/index.html"
    },
    {
      "src": "/blog",
      "dest": "/blog/index.html"
    },
    {
      "src": "/affiliate",
      "dest": "/affiliate/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)\\.js",
      "dest": "/$1.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js|svg|xml|txt)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}