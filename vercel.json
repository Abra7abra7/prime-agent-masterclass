{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.txt",
      "use": "@vercel/static"
    },
    {
      "src": "*.xml",
      "use": "@vercel/static"
    },
    {
      "src": "*.svg",
      "use": "@vercel/static"
    },
    {
      "src": "*/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "en/**/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)\\.txt",
      "dest": "/$1.txt"
    },
    {
      "src": "/(.*)\\.xml",
      "dest": "/$1.xml"
    },
    {
      "src": "/(.*)\\.svg",
      "dest": "/$1.svg"
    },
    {
      "src": "/en",
      "dest": "/en/index.html"
    },
    {
      "src": "/en/",
      "dest": "/en/index.html"
    },
    {
      "src": "/en/kurz",
      "dest": "/en/kurz/index.html"
    },
    {
      "src": "/en/o-nas",
      "dest": "/en/o-nas/index.html"
    },
    {
      "src": "/en/faq",
      "dest": "/en/faq/index.html"
    },
    {
      "src": "/en/blog",
      "dest": "/en/blog/index.html"
    },
    {
      "src": "/en/affiliate",
      "dest": "/en/affiliate/index.html"
    },
    {
      "src": "/kurz",
      "dest": "/kurz/index.html"
    },
    {
      "src": "/o-nas",
      "dest": "/o-nas/index.html"
    },
    {
      "src": "/faq",
      "dest": "/faq/index.html"
    },
    {
      "src": "/blog",
      "dest": "/blog/index.html"
    },
    {
      "src": "/affiliate",
      "dest": "/affiliate/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}